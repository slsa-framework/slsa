## 3. Pre-commit hook mirroring CI

**`bin/hooks`** — tiny hook manager, no external gems.

```bash
#!/usr/bin/env bash
set -euo pipefail

HOOKS_DIR="$(git rev-parse --show-toplevel)/.githooks"
GIT_DIR="$(git rev-parse --git-dir)"

case "${1:-}" in
  install)
    mkdir -p "$HOOKS_DIR"
    if [ -d "$GIT_DIR/hooks" ] && [ ! -L "$GIT_DIR/hooks" ]; then
      rm -rf "$GIT_DIR/hooks.old"
      mv "$GIT_DIR/hooks" "$GIT_DIR/hooks.old"
    fi
    ln -sfn "$HOOKS_DIR" "$GIT_DIR/hooks"
    chmod +x "$HOOKS_DIR"/*
    echo "Git hooks installed (symlinked to .githooks/)."
    ;;
  uninstall)
    rm -f "$GIT_DIR/hooks"
    [ -d "$GIT_DIR/hooks.old" ] && mv "$GIT_DIR/hooks.old" "$GIT_DIR/hooks"
    echo "Git hooks uninstalled."
    ;;
  *)
    echo "Usage: bin/hooks {install|uninstall}"
    exit 1
    ;;
esac
```

```bash
chmod +x bin/hooks
```

**`.githooks/pre-commit`** — same checks CI runs, but only on staged files where possible.

```bash
#!/usr/bin/env bash
set -euo pipefail

echo "▶ RuboCop (staged Ruby files)"
staged_ruby=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rb|rake)$' || true)
if [ -n "$staged_ruby" ]; then
  echo "$staged_ruby" | xargs bundle exec rubocop --force-exclusion
else
  echo "  no Ruby files staged, skipping"
fi

echo "▶ Brakeman"
bundle exec brakeman -q -w2

echo "▶ bundler-audit"
bundle exec bundler-audit check --update

echo "▶ schema.rb drift"
if git diff --cached --name-only | grep -q '^db/schema\.rb$'; then
  echo "  schema.rb staged — OK"
elif git diff --cached --name-only | grep -q '^db/migrate/'; then
  echo "  ⚠ migration staged but db/schema.rb is not. Run bin/rails db:migrate."
  exit 1
fi

echo "▶ RSpec (fast subset)"
# Only run specs related to changed files if you have rspec-boost or similar.
# For a hard guarantee, run the full suite:
# bundle exec rspec
if command -v bundle >/dev/null && bundle exec rspec --dry-run spec >/dev/null 2>&1; then
  bundle exec rspec spec --fail-fast
fi

echo "✅ Pre-commit checks passed."
```

