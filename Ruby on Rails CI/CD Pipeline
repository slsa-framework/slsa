## 2. `bin/setup` onboarding script

**`bin/setup`**
```bash
#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Checking Ruby version =="
  required = File.read(".ruby-version").strip
  current  = RUBY_VERSION
  abort "Ruby #{required} required, you have #{current}" unless current.start_with?(required)

  puts "\n== Installing dependencies =="
  system! "gem install bundler --conservative"
  system! "bundle check || bundle install"

  puts "\n== Installing JavaScript dependencies =="
  system! "yarn install --check-files" if File.exist?("yarn.lock")
  system! "npm ci"                    if File.exist?("package-lock.json")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Loading seed data =="
  system! "bin/rails db:seed" if File.exist?("db/seeds.rb")

  puts "\n== Copying example configs =="
  if File.exist?("config/database.yml.example") && !File.exist?("config/database.yml")
    FileUtils.cp "config/database.yml.example", "config/database.yml"
    puts "  created config/database.yml"
  end
  if File.exist?(".env.example") && !File.exist?(".env")
    FileUtils.cp ".env.example", ".env"
    puts "  created .env"
  end

  puts "\n== Installing git hooks =="
  system! "bin/hooks install"

  puts "\n== Clearing logs and tmp =="
  FileUtils.rm_rf Dir["log/*"] + Dir["tmp/*"]
  FileUtils.mkdir_p "log"
  FileUtils.mkdir_p "tmp/pids"
  FileUtils.touch "log/development.log"
  FileUtils.touch "log/test.log"

  puts "\n== Setup complete =="
  puts "Start the app with: bin/dev"
end
