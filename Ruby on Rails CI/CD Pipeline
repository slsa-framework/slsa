## 5. `config/deploy.yml` — production

Fill in `<owner>`, `<repo>`, and your host IPs. This is read by `bin/kamal deploy` from the `deploy` job.

```yaml
service: myapp
image: ghcr.io/<owner>/<repo>

servers:
  web:
    - 203.0.113.10          # <-- production web server IP
  # job:
  #   hosts:
  #     - 203.0.113.10
  #   cmd: bin/jobs         # if you use Solid Queue

proxy:
  ssl: true
  host: example.com         # <-- your production hostname
  healthcheck:
    path: /up
    interval: 10s

registry:
  server: ghcr.io
  username: <owner>
  password:
    - KAMAL_REGISTRY_PASSWORD

builder:
  arch: amd64
  cache:
    type: gha
    options: mode=max

env:
  clear:
    RAILS_ENV: production
    RAILS_LOG_TO_STDOUT: "true"
    RAILS_SERVE_STATIC_FILES: "true"
  secret:
    - RAILS_MASTER_KEY
    - DATABASE_URL
    - REDIS_URL

volumes:
  - "myapp_storage:/rails/storage"

asset_path: /rails/public/assets

aliases:
  console: app exec --interactive --reuse "bin/rails console"
  shell:   app exec --interactive --reuse "bash"
  logs:    app logs -f
  dbc:     app exec --interactive --reuse "bin/rails dbconsole"
```

